<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Mixtape.App"
        x:Class="Mixtape.App.Views.SettingsWindow"
        Title="Settings" Width="460" Height="368"
        Background="{StaticResource AppBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Inter" CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="26" Spacing="14">
    <TextBlock Text="{l:Loc 'Settings'}" FontSize="20" FontWeight="Bold"/>
    <TextBlock Text="{l:Loc 'ACCENT COLOUR'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SubtleBrush}" Margin="0,6,0,0"/>
    <WrapPanel x:Name="AccentPanel" Orientation="Horizontal"/>
    <TextBlock Text="{l:Loc 'THEME'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SubtleBrush}" Margin="0,8,0,0"/>
    <StackPanel x:Name="VariantPanel" Orientation="Horizontal" Spacing="8"/>
    <TextBlock Text="{l:Loc 'LANGUAGE'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SubtleBrush}" Margin="0,8,0,0"/>
    <StackPanel x:Name="LanguagePanel" Orientation="Horizontal" Spacing="8"/>
    <TextBlock x:Name="RestartNote" Text="{l:Loc 'Restart Mixtape to change the language.'}" FontSize="11"
               Foreground="{StaticResource AccentBrush}" IsVisible="False"/>
    <Button Content="{l:Loc 'Done'}" Click="OnDone" HorizontalAlignment="Right" Margin="0,6,0,0"/>
  </StackPanel>
</Window>
