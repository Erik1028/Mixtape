<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Mixtape.App.App"
             RequestedThemeVariant="Dark">

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

    <!-- Generic action buttons (Refresh / Open folder / Add folder / Add music / Done / empty-state CTAs) get the
         app's hand-crafted "chip" look instead of default Fluent. Scoped with :not(...) so the classed buttons
         (.play/.ghost/.winbtn/.star) keep their own explicit styling untouched. -->
    <!-- literal greys (not StaticResource): resources aren't in scope yet when Application.Styles is built.
         These are fixed brand greys (SubtleBrush #A8ACB0 / TextBrush #F2F2F3), never accent-retinted. -->
    <Style Selector="Button:not(.play):not(.ghost):not(.winbtn):not(.star)">
      <Setter Property="Background" Value="#1CFFFFFF"/>
      <Setter Property="Foreground" Value="#A8ACB0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button:not(.play):not(.ghost):not(.winbtn):not(.star):pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#26FFFFFF"/>
      <Setter Property="Foreground" Value="#F2F2F3"/>
    </Style>
    <Style Selector="Button:not(.play):not(.ghost):not(.winbtn):not(.star):pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#14FFFFFF"/>
    </Style>
  </Application.Styles>

  <Application.Resources>
    <!-- Match the WinForms app's "Graphite + Teal" palette. -->
    <Color x:Key="SystemAccentColor">#00C8AA</Color>
    <Color x:Key="SystemAccentColorDark1">#00B49A</Color>
    <Color x:Key="SystemAccentColorDark2">#009E88</Color>
    <Color x:Key="SystemAccentColorDark3">#008876</Color>
    <Color x:Key="SystemAccentColorLight1">#33D3BB</Color>
    <Color x:Key="SystemAccentColorLight2">#5BDDCB</Color>
    <Color x:Key="SystemAccentColorLight3">#84E7DB</Color>

    <SolidColorBrush x:Key="WallpaperBrush" Color="#0E0F10"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#16171A"/>
    <SolidColorBrush x:Key="AppBrush" Color="#1D1E22"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#282B30"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#00C8AA"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F2F2F3"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="#A8ACB0"/>
    <SolidColorBrush x:Key="HairlineBrush" Color="#2C2E33"/>
  </Application.Resources>
</Application>
